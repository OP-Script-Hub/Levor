status.Parent = background

local percent = Instance.new("TextLabel")
percent.Size = UDim2.new(0.55, 0, 0, 20)
percent.Position = UDim2.new(0.225, 0, 0.59, 0)
percent.BackgroundTransparency = 1
percent.Text = "0%"
percent.TextColor3 = Color3.fromRGB(75, 255, 135)
percent.Font = Enum.Font.GothamBold
percent.TextSize = 11
percent.TextXAlignment = Enum.TextXAlignment.Right
percent.Parent = background

local messages = {
    "[NEXUS] Initializing system...",
    "[NEXUS] Loading required components...",
    "[NEXUS] Checking configuration...",
    "[NEXUS] Preparing game interface...",
    "[NEXUS] Loading visual assets...",
    "[NEXUS] Optimizing interface...",
    "[NEXUS] Finalizing initialization..."
}

local duration = 120

for elapsed = 1, duration do
    local progress = elapsed / duration

    bar.Size = UDim2.new(progress, 0, 1, 0)
    percent.Text = math.floor(progress * 100) .. "%"

    local index = math.min(
        math.floor(progress * #messages) + 1,
        #messages
    )

    status.Text = messages[index]

    task.wait(1)
end

status.Text = "[SUCCESS] Loading completed!"
percent.Text = "100%"

task.wait(1)

local fade = TweenService:Create(
    background,
    TweenInfo.new(0.6),
    {BackgroundTransparency = 1}
)

fade:Play()
fade.Completed:Wait()

gui:Destroy()

