local activeCycle = 0
local function doApply()
    if busy or not alive then return end
    busy = true
    activeCycle = activeCycle + 1
    local cycle = activeCycle
    local t = traits[selected]
    apply.Text = "LOADING..."
    tween(applyScale,.1,{Scale=1})
    overlay.Visible = true
    loading.Visible = true
    success.Visible = false
    loadingTitle.Text = "Applying " .. t.name .. "..."
    progressText.Text = "0%"
    progressFill.Size = UDim2.fromScale(0,1)
    loadScale.Scale = .85
    tween(loadScale,.25,{Scale=1},Enum.EasingStyle.Back)

    local start = os.clock()
    while alive and gui.Parent and cycle == activeCycle do
        local percent = math.clamp((os.clock()-start)/LOAD_DURATION,0,1)
        progressFill.Size = UDim2.fromScale(percent,1)
        progressText.Text = tostring(math.floor(percent*100)) .. "%"
        if percent >= 1 then break end
        RunService.Heartbeat:Wait()
    end
    if not alive or not gui.Parent or cycle ~= activeCycle then return end
    progressFill.Size = UDim2.fromScale(1,1)
    progressText.Text = "100%"
    task.wait(.15)
    if not alive or not gui.Parent then return end
    loading.Visible = false
    success.Visible = true
    clearOutcomeIcon(t.icon)
    outcomeText.Text = t.name
    successScale.Scale = .5
    tween(successScale,.46,{Scale=1},Enum.EasingStyle.Back,Enum.EasingDirection.Out)
    task.wait(RESULT_DURATION)
    if not alive or not gui.Parent then return end
    tween(successScale,.38,{Scale=.12},Enum.EasingStyle.Back,Enum.EasingDirection.In)
    task.wait(.4)
    if not alive or not gui.Parent then return end
    success.Visible = false
    overlay.Visible = false
    apply.Text = "APPLY"
    busy = false
end
connect(apply.MouseButton1Click,function() task.spawn(doApply) end)

local function shutdown()
    if not alive then return end
    alive = false
    activeCycle = activeCycle + 1
    for _, conn in ipairs(connections) do conn:Disconnect() end
    if gui.Parent then gui:Destroy() end
end
connect(closeButton.MouseButton1Click,shutdown)

-- Drag anywhere on the title bar, works with touch and mouse; X remains clickable.
local dragging = false
local dragInput, dragOrigin, panelOrigin
connect(header.InputBegan,function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or
       input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragInput = input
        dragOrigin = input.Position
        panelOrigin = panel.Position
    end
end)
connect(UserInput.InputChanged,function(input)
    if not dragging or not dragOrigin then return end
    if input.UserInputType == Enum.UserInputType.MouseMovement or
       (dragInput and input == dragInput) then
        local movement = input.Position - dragOrigin
        local s = responsiveScale.Scale
        panel.Position = UDim2.new(panelOrigin.X.Scale, panelOrigin.X.Offset+movement.X,
            panelOrigin.Y.Scale, panelOrigin.Y.Offset+movement.Y)
    end
end)
connect(UserInput.InputEnded,function(input)
    if input == dragInput or input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = false
        dragInput = nil
    end
end)

