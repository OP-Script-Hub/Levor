local function create(class, props, parent)
    local object = Instance.new(class)
    for key, value in pairs(props or {}) do object[key] = value end
    object.Parent = parent
    return object
end
local function rgb(r, g, b) return Color3.fromRGB(r, g, b) end
local function round(object, radius)
    return create("UICorner", {CornerRadius = UDim.new(0, radius)}, object)
end
local function stroke(object, color, thickness, trans)
    return create("UIStroke", {
        Color = color or rgb(255, 255, 255),
        Thickness = thickness or 2,
        Transparency = trans or 0,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    }, object)
end
local rainbowColors = ColorSequence.new({
    ColorSequenceKeypoint.new(0.00, rgb(38, 182, 255)),
    ColorSequenceKeypoint.new(0.16, rgb(121, 52, 255)),
    ColorSequenceKeypoint.new(0.33, rgb(249, 50, 198)),
    ColorSequenceKeypoint.new(0.49, rgb(255, 118, 45)),
    ColorSequenceKeypoint.new(0.64, rgb(248, 239, 42)),
    ColorSequenceKeypoint.new(0.80, rgb(56, 246, 116)),
    ColorSequenceKeypoint.new(1.00, rgb(38, 182, 255))
})
local gradients = {}
local function rainbow(object, rotation)
    local g = create("UIGradient", {Color = rainbowColors, Rotation = rotation or 0}, object)
    table.insert(gradients, g)
    return g
end
local function tween(object, duration, props, easingStyle, easingDirection)
    local info = TweenInfo.new(duration, easingStyle or Enum.EasingStyle.Quad,
        easingDirection or Enum.EasingDirection.Out)
    local t = TweenService:Create(object, info, props)
    t:Play()
    return t
end
local function textLabel(parent, value, size, position, dimensions, color, font, z)
    return create("TextLabel", {
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        Text = value,
        Font = font or Enum.Font.FredokaOne,
        TextSize = size,
        TextColor3 = color or rgb(255, 255, 255),
        TextStrokeColor3 = rgb(0, 0, 0),
        TextStrokeTransparency = 0.4,
        Position = position,
        Size = dimensions,
        TextXAlignment = Enum.TextXAlignment.Center,
        TextYAlignment = Enum.TextYAlignment.Center,
        ZIndex = z or 3
    }, parent)
end

-- Icon shapes: constructed from Roblox Frames, no external image asset needed.
local function crown(parent, position, size, z)
    local root = create("Frame", {
        Position = position, Size = size, BackgroundTransparency = 1,
        BorderSizePixel = 0, ZIndex = z or 5
    }, parent)
    local blocks = {
        {0.07,0.10,0.19,0.33}, {0.41,0.00,0.18,0.45}, {0.74,0.10,0.19,0.33},
        {0.07,0.36,0.86,0.24}, {0.13,0.60,0.74,0.13}, {0.13,0.78,0.74,0.17}
    }
    for _, p in ipairs(blocks) do
        local block = create("Frame", {
            Position = UDim2.fromScale(p[1], p[2]),
            Size = UDim2.fromScale(p[3], p[4]),
            BackgroundColor3 = rgb(255,255,255), BorderSizePixel = 0,
            ZIndex = (z or 5) + 1
        }, root)
        rainbow(block, 20)
        stroke(block, rgb(7,6,17), 1.4)
    end
    return root
end
local function sparkle(parent, position, size, z)
    local root = create("Frame", {
        Position = position, Size = size, BackgroundTransparency = 1, ZIndex = z or 5
    }, parent)
    local pieces = {
        {0.29,0.28,0.44,0.44,45}, {0.05,0.02,0.18,0.18,45},
        {0.75,0.04,0.14,0.14,45}, {0.75,0.75,0.16,0.16,45}
    }
    for _, p in ipairs(pieces) do
        local piece = create("Frame", {
            Position = UDim2.fromScale(p[1], p[2]),
            Size = UDim2.fromScale(p[3], p[4]),
            Rotation = p[5], BackgroundColor3 = rgb(255,255,255),
            BorderSizePixel = 0, ZIndex = (z or 5) + 1
        }, root)
        rainbow(piece, 40)
    end
    return root
end
local function traitIcon(parent, kind, position, size, z)
    if kind == "crown" then return crown(parent, position, size, z) end
    return sparkle(parent, position, size, z)
end

