-- Dropdown popup is attached to the WINDOW, not the card, so it can overlay other controls.
local function dropdown(parent,x,y,w,options,value,changed,prefix)
    prefix=prefix or "Method"
    local b=click(parent,"  "..prefix.." - "..tostring(value),x,y,w,28,nil,{
        bg=C.dropdown,alpha=.07,color=C.secondary,size=10,radius=4,z=7
    })
    stroke(b,.72)
    text(b,"⌄",w-19,1,15,26,{size=14,color=C.dim,align=Enum.TextXAlignment.Center,z=8})
    b.MouseButton1Click:Connect(function()
        if activePopup then closePopup() end
        local px=(b.AbsolutePosition.X-window.AbsolutePosition.X)/scaler.Scale
        local py=(b.AbsolutePosition.Y-window.AbsolutePosition.Y)/scaler.Scale+28+3
        local popupH=#options*26+4
        if py+popupH>HEIGHT-6 then py=py-popupH-34 end
        local pop=rect(window,px,py,w,popupH,C.dropdown,.01,4,.15,90)
        activePopup=pop
        for i,opt in ipairs(options) do
            local item=click(pop,"  "..opt,3,2+(i-1)*26,w-6,26,function()
                b.Text="  "..prefix.." - "..opt
                if changed then changed(opt) end
                closePopup()
            end,{bg=C.active,alpha=.45,color=C.text,size=10,z=91})
            item.MouseEnter:Connect(function()item.BackgroundTransparency=.04 end)
            item.MouseLeave:Connect(function()item.BackgroundTransparency=.45 end)
        end
    end)
    return b
end
local function toggle(parent,label,x,y,value,changed)
    text(parent,label,x,y,132,20,{size=9,color=C.secondary})
    local bg=click(parent,"",x+137,y+2,29,16,nil,{bg=Color3.fromRGB(59,57,64),alpha=0,z=8,radius=12})
    local knob=rect(bg,value and 16 or 3,3,10,10,value and C.text or Color3.fromRGB(151,147,155),0,10,false,9)
    local on=value
    local function set(v,signal)
        on=v
        animate(bg,{BackgroundColor3=on and Color3.fromRGB(100,97,106) or Color3.fromRGB(59,57,64)})
        animate(knob,{Position=UDim2.fromOffset(on and 16 or 3,3),BackgroundColor3=on and C.text or Color3.fromRGB(151,147,155)})
        if signal and changed then changed(on) end
    end
    bg.MouseButton1Click:Connect(function()set(not on,true)end)
    return set
end
