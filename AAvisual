local function slider(parent,x,y,w,minValue,maxValue,value,changed)
    local track=rect(parent,x,y+8,w,3,Color3.fromRGB(77,75,83),0,2,false,7)
    local fill=rect(track,0,0,0,3,C.secondary,0,2,false,8)
    local dot=rect(parent,x-5,y+4,11,11,C.text,0,10,false,9)
    local hit=click(parent,"",x-7,y,w+14,21,nil,{alpha=1,z=10})
    local pressed=false
    local touch=nil
    local function update(num)
        local f=math.clamp((num-minValue)/(maxValue-minValue),0,1)
        fill.Size=UDim2.new(f,0,1,0)
        dot.Position=UDim2.fromOffset(x+f*w-5,y+4)
        if changed then changed(minValue+f*(maxValue-minValue)) end
    end
    local function inputMove(input)
        local f=(input.Position.X-(hit.AbsolutePosition.X+7*scaler.Scale))/(w*scaler.Scale)
        update(minValue+math.clamp(f,0,1)*(maxValue-minValue))
    end
    hit.InputBegan:Connect(function(input)
        if input.UserInputType==Enum.UserInputType.MouseButton1 or input.UserInputType==Enum.UserInputType.Touch then
            pressed=true
            touch=(input.UserInputType==Enum.UserInputType.Touch) and input or nil
            inputMove(input)
        end
    end)
    local moved=UIS.InputChanged:Connect(function(input)
        if pressed and ((touch and input==touch) or (not touch and input.UserInputType==Enum.UserInputType.MouseMovement)) then
            inputMove(input)
        end
    end)
    local ended=UIS.InputEnded:Connect(function(input)
        if pressed and ((touch and input==touch) or (not touch and input.UserInputType==Enum.UserInputType.MouseButton1)) then
            pressed=false; touch=nil
        end
    end)
    hit.Destroying:Connect(function()moved:Disconnect();ended:Disconnect()end)
    update(value)
end

