-- Drag by the top bar, mouse or touch. Frame remains a floating overlay in game.
local dragging=false
local dragTouch=nil
local dragStart=nil
local startPosition=nil
bar.InputBegan:Connect(function(input)
    if input.UserInputType==Enum.UserInputType.MouseButton1 or input.UserInputType==Enum.UserInputType.Touch then
        dragging=true
        dragStart=input.Position
        startPosition=window.Position
        dragTouch=(input.UserInputType==Enum.UserInputType.Touch) and input or nil
        closePopup()
    end
end)
local dragMoved=UIS.InputChanged:Connect(function(input)
    if not dragging then return end
    if not ((dragTouch and input==dragTouch) or (not dragTouch and input.UserInputType==Enum.UserInputType.MouseMovement)) then return end
    local delta=input.Position-dragStart
    local camera=workspace.CurrentCamera
    local viewport=camera and camera.ViewportSize or Vector2.new(1280,720)
    local x=startPosition.X.Scale*viewport.X+startPosition.X.Offset+delta.X
    local y=startPosition.Y.Scale*viewport.Y+startPosition.Y.Offset+delta.Y
    local sw=WIDTH*scaler.Scale
    local sh=(minimized and 24 or HEIGHT)*scaler.Scale
    x=math.clamp(x,sw/2+3,math.max(sw/2+3,viewport.X-sw/2-3))
    y=math.clamp(y,sh/2+3,math.max(sh/2+3,viewport.Y-sh/2-3))
    window.Position=UDim2.fromOffset(x,y)
end)
local dragEnded=UIS.InputEnded:Connect(function(input)
    if (dragTouch and input==dragTouch) or (not dragTouch and input.UserInputType==Enum.UserInputType.MouseButton1) then
        dragging=false
        dragTouch=nil
    end
end)
local keyboardConn=UIS.InputBegan:Connect(function(input,handled)
    if not handled and input.KeyCode==Enum.KeyCode.RightShift then
        if launcher.Visible then
            launcher.Visible=false
            window.Visible=true
        else
            window.Visible=not window.Visible
        end
        closePopup()
    end
end)

gui.Destroying:Connect(function()
    dragMoved:Disconnect()
    dragEnded:Disconnect()
    keyboardConn:Disconnect()
    cameraConn:Disconnect()
    if viewportConn then viewportConn:Disconnect() end
end)
