local function new(class, props, parent)
    local obj = Instance.new(class)
    for k,v in pairs(props or {}) do obj[k] = v end
    obj.Parent = parent
    return obj
end
local function round(obj, radius)
    return new("UICorner", {CornerRadius=UDim.new(0,radius or 5)}, obj)
end
local function stroke(obj, transparency)
    return new("UIStroke", {Color=C.border, Transparency=transparency or .44, Thickness=1}, obj)
end
local function rect(parent,x,y,w,h,color,alpha,radius,withStroke,z)
    local item = new("Frame", {
        Position=UDim2.fromOffset(x,y), Size=UDim2.fromOffset(w,h),
        BackgroundColor3=color or C.panel, BackgroundTransparency=alpha or 0,
        BorderSizePixel=0, ZIndex=z or 2,
    }, parent)
    if radius and radius > 0 then round(item,radius) end
    if withStroke then stroke(item,withStroke == true and .42 or withStroke) end
    return item
end
local function text(parent, str,x,y,w,h,opts)
    opts=opts or {}
    return new("TextLabel",{
        Position=UDim2.fromOffset(x,y),Size=UDim2.fromOffset(w,h),
        BackgroundTransparency=1, BorderSizePixel=0, Text=tostring(str),
        Font=opts.font or Enum.Font.Gotham, TextSize=opts.size or 10,
        TextColor3=opts.color or C.secondary,
        TextXAlignment=opts.align or Enum.TextXAlignment.Left,
        TextYAlignment=Enum.TextYAlignment.Center,
        TextWrapped=opts.wrap or false,
        TextTruncate=Enum.TextTruncate.AtEnd,
        ZIndex=opts.z or 4,
    },parent)
end
local function line(parent,x,y,w,z)
    return rect(parent,x,y,w,1,C.border,.63,0,false,z or 3)
end
local function click(parent,label,x,y,w,h,fn,opts)
    opts=opts or {}
    local b=new("TextButton",{
        Position=UDim2.fromOffset(x,y),Size=UDim2.fromOffset(w,h),
        BackgroundColor3=opts.bg or C.active,
        BackgroundTransparency=(opts.alpha~=nil) and opts.alpha or 1,
        BorderSizePixel=0,AutoButtonColor=false,
        Text=label or "", TextColor3=opts.color or C.secondary,
        Font=Enum.Font.Gotham,TextSize=opts.size or 10,
        TextXAlignment=opts.align or Enum.TextXAlignment.Left,
        TextTruncate=Enum.TextTruncate.AtEnd,
        ZIndex=opts.z or 5,
    },parent)
    if opts.radius then round(b,opts.radius) end
    if fn then b.MouseButton1Click:Connect(fn) end
    return b
end
local function animate(obj,properties)
    if obj.Parent then
        TweenService:Create(obj,TweenInfo.new(.14,Enum.EasingStyle.Quad,Enum.EasingDirection.Out),properties):Play()
    end
end

